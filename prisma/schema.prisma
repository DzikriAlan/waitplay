generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_CONNECTION_STRING")
  directUrl = env("SUPABASE_DIRECT_URL")
}

model GameRoom {
  id        String   @id @default(cuid())
  code      String   @unique
  game      String
  status    String   @default("lobby")
  seatTotal Int      @default(2)
  players   Json
  turn      String   @default("p1")
  state     Json
  moveTotal Int      @default(0)
  winner    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([game, status, updatedAt])
  @@map("game_rooms")
}
